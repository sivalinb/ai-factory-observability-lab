{
  "uid": "factory-workloads",
  "title": "Factory / Training and inference",
  "description": "AI Factory Reliability Lab. Default vendor and workload feeds are simulated. Origins remain visible. Source-linked documentation accompanies every signal.",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "tags": [
    "ai-factory",
    "nvidia",
    "observability-lab"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "style": "dark",
  "panels": [
    {
      "type": "marcusolsson-dynamictext-panel",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "lab_factory_info",
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "editorMode": "code",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "content": "{{#each data}}<div class='hero'><div><div class='eyebrow'>AI FACTORY / WORKLOADS 03</div><div class='headline'>Measure useful work, not just busy GPUs.</div><div class='subline'>Training progress, scheduling fairness and inference experience, side by side.</div><div class='nav'><a href='/d/factory-overview'>Overview \u2197</a><a href='/d/factory-fabric'>Fabric \u2197</a><a href='/d/factory-workloads'>Workloads \u2197</a><a href='/d/factory-signals'>Signal atlas \u2197</a><a href='http://localhost:8090' target='_blank'>Scenario console \u2197</a></div></div><div class='pill'>{{mode}} / {{signal_count}} SIGNALS</div></div>{{/each}}",
        "defaultContent": "<div class='brief'><h3>Telemetry unavailable</h3><p>Check the source feed and time range. Missing telemetry is not healthy telemetry.</p></div>",
        "renderMode": "allRows",
        "editors": [
          "styles"
        ],
        "editor": {
          "language": "html",
          "format": "auto"
        },
        "styles": "\n& { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #eef3ef; }\n.hero {padding: 20px 24px; display:flex; justify-content:space-between; align-items:center; background:linear-gradient(110deg,#19261d,#121820 68%); border-left:4px solid #b7f77b; min-height:90px;}\n.eyebrow {font-size:10px; font-weight:700; letter-spacing:2.3px; color:#b7f77b; margin-bottom:8px;}\n.headline {font-size:27px; font-weight:600; letter-spacing:-0.7px; margin:0 0 6px;}\n.subline {font-size:12px; color:#a3afa8; line-height:1.5;}\n.pill {border:1px solid #5c6b43; border-radius:18px; padding:6px 12px; font-size:10px; letter-spacing:1px; color:#b7f77b; white-space:nowrap;}\n.nav {display:flex;gap:14px;margin-top:13px;flex-wrap:wrap;}\n.nav a,.runbook a {color:#c8ef99;text-decoration:none;font-size:11px;}\n.domains {display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:8px;padding:12px 8px;}\n.domain {background:#171f1c;border:1px solid #34413a;border-radius:7px;padding:14px 10px;min-height:78px;}\n.domain-title {font-size:9px;letter-spacing:1.1px;color:#aab7ae;margin-bottom:14px;}\n.status {font-size:12px;font-weight:600;letter-spacing:.4px;}\n.caption {font-size:9px;color:#7f8b84;margin-top:9px;}\n.brief {padding:17px 18px;border-left:3px solid #ff9770;background:linear-gradient(130deg,#251c18,#161b20);margin:8px;border-radius:3px;}\n.brief h3 {font-size:18px;margin:9px 0 12px;letter-spacing:-.3px;}\n.brief p {color:#c1c6c0;font-size:11px;line-height:1.65;margin:8px 0;}\n.brief .meta {font-size:10px;color:#a9b8a9;letter-spacing:.3px;}\n.runbook {margin-top:12px;border-top:1px solid #39413a;padding-top:10px;}\n.source-grid {display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;padding:8px;}\n.source {padding:12px;background:#17201d;border:1px solid #34413a;border-radius:6px;}\n.source b {font-size:12px;color:#d9eed0;} .source small {display:block;font-size:10px;color:#96a599;margin-top:7px;}\n.source a {display:block;font-size:10px;color:#b7f77b;margin-top:8px;}\n@media(max-width:900px){.domains{grid-template-columns:repeat(4,minmax(0,1fr));}.headline{font-size:22px}.source-grid{grid-template-columns:repeat(3,minmax(0,1fr));}}\n",
        "helpers": "",
        "afterRender": "",
        "externalStyles": [],
        "contentPartials": [],
        "wrap": false
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Training steps \u00b7 every rank",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "description": "lab_training_step_seconds: Most recent training step per rank. Unit: second. lab-defined normalized metric.",
      "targets": [
        {
          "refId": "A",
          "expr": "lab_training_step_seconds{workload=\"train-42\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "editorMode": "code",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "rank {{rank}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "axisPlacement": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "links": [
        {
          "title": "Application instrumentation \u00b7 original docs",
          "url": "https://docs.pytorch.org/docs/stable/distributed.html",
          "targetBlank": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "First token and completion \u00b7 p95",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "description": "e2e_request_latency_seconds: Request completion latency distribution. Unit: second. documented exporter name.",
      "targets": [
        {
          "refId": "A",
          "expr": "lab:inference_ttft_p95_seconds",
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "editorMode": "code",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "TTFT p95"
