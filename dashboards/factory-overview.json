    {
      "type": "timeseries",
      "title": "Useful work \u00b7 training and inference",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "description": "generation_tokens_total: Generated output tokens. Unit: tokens. documented exporter name.\nlab_training_tokens_total: Training tokens processed. Unit: tokens. lab-defined normalized metric.",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(lab_training_tokens_total{workload=\"train-42\"}[1m])",
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "editorMode": "code",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "Training tokens/s"
        },
        {
          "refId": "B",
          "expr": "rate(generation_tokens_total[1m])",
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "editorMode": "code",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "Inference tokens/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tokens/s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
