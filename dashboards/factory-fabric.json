    {
      "type": "timeseries",
      "title": "Bit error ratios \u00b7 post-FEC and pre-FEC",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "factory-prometheus"
      },
      "description": "lab_ufm_effective_ber_ratio: Post-FEC bit error ratio. Unit: ratio. lab-defined normalized metric.\nlab_ufm_raw_ber_ratio: Pre-FEC bit error ratio. Unit: ratio. lab-defined normalized metric.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(lab_ufm_effective_ber_ratio)",
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "editorMode": "code",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "Effective BER"
        },
        {
          "refId": "B",
          "expr": "max(lab_ufm_raw_ber_ratio)",
          "datasource": {
            "type": "prometheus",
            "uid": "factory-prometheus"
          },
          "editorMode": "code",
          "format": "time_series",
          "instant": false,
          "range": true,
          "legendFormat": "Raw BER"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "sci",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "axisPlacement": "auto",
            "spanNulls": false,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4,
      "links": [
        {
          "title": "UFM Telemetry \u00b7 original docs",
          "url": "https://networking-docs.nvidia.com/ufmenterpriseum/6244/low-frequency-secondary-telemetry-fields",
          "targetBlank": true
        }
      ]
    },
